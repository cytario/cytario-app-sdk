# Runtime base image for non-Python Cytario analysis apps.
#
# Contains exactly one thing: the frozen cytario-app-sdk wrapper binary at
# /opt/sdk/bin/cytario-app-sdk, self-contained (CPython + typer + boto3 +
# CA bundle). An app image layers on top of its algorithm image and COPYs
# the binary in:
#
#   FROM <algorithm-image>
#   COPY --from=harbor.cytario.org/oss/cytario-app-sdk-runtime:<ver> \
#        /opt/sdk/bin/cytario-app-sdk /usr/local/bin/cytario-app-sdk
#   ENTRYPOINT ["/usr/local/bin/cytario-app-sdk", "run", "--"]
#   CMD ["<algorithm>", "...", "--flags-matching-your-parameterSchema"]
#
# The final stage is distroless python3-debian12:nonroot (pinned by digest).
# The frozen binary is a dynamically linked CPython: beyond glibc its stdlib
# extension modules need libz/libbz2/liblzma/libffi/libexpat/libcrypt —
# distroless *base*-debian12 ships none of those (the CI runtime-container
# job caught it: "ImportError: libz.so.1"), while python3-debian12 is built
# precisely to provide a CPython's dynamic dependencies. No shell, no
# package manager, runs as the nonroot user.
#
# The freeze stage builds on the same release (bookworm) so the extension
# modules link against the same library versions the final stage runs.

# distroless/python3-debian12:nonroot, multi-arch index.
FROM gcr.io/distroless/python3-debian12:nonroot@sha256:7d1042ce588ab97019fe95c24ffca7bc5a82ccdac572511d5e09bda4435c89c5 AS final-base

FROM debian:12 AS freeze

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip python3-dev build-essential && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

# Pin the runtime extra so the frozen binary is reproducible.
RUN pip3 install --break-system-packages --no-cache-dir \
      ".[runtime]" "cx_Freeze>=7.2"

# Build the frozen binary into build/exe.linux-x86_64-3.*/.
RUN python3 freeze/setup.py build

FROM final-base AS final

# The build directory is the exe plus lib/ (and share/) with $ORIGIN-relative
# rpaths, so the whole tree is copied preserving its internal layout. The
# copy target puts the binary at /opt/sdk/bin/cytario-app-sdk — the path all
# consuming app images COPY --from= and the workflow smokes reference.
COPY --from=freeze /src/build/exe.linux-x86_64-3.*/ /opt/sdk/bin/
